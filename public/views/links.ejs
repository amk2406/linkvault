<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#FFB300" />
  <title>My Links · LinkVault</title>
  <link rel="stylesheet" href="/static/style/properties.css" />
  <link rel="stylesheet" href="/static/style/base.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- Header -->
  <header class="header">
    <div class="container header-inner">
      <a href="/dashboard" class="logo">
        <span>Link</span>Vault
      </a>
      <nav class="nav">
        <a href="/dashboard" class="nav-link">Dashboard</a>
        <a href="/links" class="nav-link active">Links</a>
        <a href="/auth/logout" class="nav-link">Logout</a>
      </nav>
    </div>
  </header>

  <div class="dashboard">
    <!-- Sidebar -->
    <aside class="sidebar">
      <nav class="sidebar-nav">
        <a href="/dashboard" class="sidebar-link">
          <span>📊</span> Overview
        </a>
        <a href="/links" class="sidebar-link active">
          <span>🔗</span> My Links
        </a>
        <a href="/links/new" class="sidebar-link">
          <span>➕</span> Create Link
        </a>
        <a href="/settings" class="sidebar-link">
          <span>⚙️</span> Settings
        </a>
        <a href="/auth/logout" class="sidebar-link">
          <span>🚪</span> Logout
        </a>
      </nav>
    </aside>

    <!-- Main content -->
    <main class="main-content">
      <h1 class="page-title">My Links</h1>
      <p class="page-subtitle">Manage all your short links in one place.</p>

      <!-- Toolbar -->
      <div class="toolbar">
        <div class="search-box">
          <span class="search-icon">🔍</span>
          <input
            type="search"
            class="form-input"
            placeholder="Search links..."
            name="q"
            value="<%= typeof query !== 'undefined' ? query : '' %>"
          />
        </div>
        <div class="flex gap-3">
          <a href="/links/new" class="btn btn-primary">+ New Link</a>
        </div>
      </div>

      <!-- Links table -->
      <% if (typeof links !== 'undefined' && links.length > 0) { %>
        <table class="links-table">
          <thead>
            <tr>
              <th>Short Link</th>
              <th>Destination</th>
              <th>Clicks</th>
              <th>Status</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% links.forEach(function(link) { %>
              <tr>
                <td>
                  <a href="/<%= link.slug %>" class="link-url" target="_blank" rel="noopener">
                    /<%= link.slug %>
                  </a>
                </td>
                <td>
                  <span class="link-url" title="<%= link.url %>"><%= link.url %></span>
                </td>
                <td><%= link.clicks || 0 %></td>
                <td>
                  <% if (link.active !== false) { %>
                    <span class="badge badge-success">Active</span>
                  <% } else { %>
                    <span class="badge badge-warning">Inactive</span>
                  <% } %>
                </td>
                <td class="text-muted"><%= link.createdAt || '—' %></td>
                <td>
                  <div class="flex gap-2">
                    <a href="/links/<%= link.id %>/edit" class="btn btn-sm btn-ghost">Edit</a>
                    <form action="/links/<%= link.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete this link?');">
                      <button type="submit" class="btn btn-sm btn-ghost text-danger">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <div class="card">
          <div class="empty-state">
            <h3>No links found</h3>
            <p>You haven't created any short links yet.</p>
            <a href="/links/new" class="btn btn-primary mt-4">Create your first link</a>
          </div>
        </div>
      <% } %>
    </main>
  </div>
</body>
</html>
