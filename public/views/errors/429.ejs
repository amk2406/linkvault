
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#FFB300">
  <title>429 · Too Many Requests · LinkVault</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
      background: #fff;
      color: #1a1207;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 24px;
    }

    .error-page {
      width: 100%;
      max-width: 420px;
      text-align: center;
    }

    .error-code {
      font-size: 76px;
      line-height: 1;
      font-weight: 800;
      color: #ffb300;
      margin-bottom: 16px;
    }

    h1 {
      font-size: 25px;
      margin-bottom: 12px;
    }

    .message {
      color: #75664f;
      line-height: 1.6;
      margin-bottom: 24px;
    }

    .retry {
      background: #fff8e1;
      border: 1px solid #ffe082;
      border-radius: 10px;
      padding: 22px;
      margin-bottom: 24px;
    }

    .retry-label {
      font-size: 14px;
      color: #75664f;
      margin-bottom: 8px;
    }

    .timer {
      font-size: 42px;
      font-weight: 750;
      font-family: monospace;
      color: #e69500;
      margin-bottom: 8px;
    }

    .hint {
      font-size: 12px;
      color: #8b7355;
      margin-bottom: 16px;
    }

    .buttons {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
    }

    .btn {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      min-height: 42px;
      padding: 0 18px;
      border-radius: 7px;
      border: 1px solid transparent;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      transition: .2s;
    }

    .primary {
      background: #ffb300;
      color: #1a1207;
    }

    .primary:hover:not(:disabled) {
      background: #ffa000;
    }

    .secondary {
      background: #fff;
      color: #1a1207;
      border-color: #e5d8bd;
    }

    .secondary:hover {
      background: #fff8e1;
    }

    button:disabled {
      opacity: .5;
      cursor: not-allowed;
    }

    @media (prefers-color-scheme: dark) {
      body {
        background: #121212;
        color: #fff8e1;
      }

      .message,
      .retry-label {
        color: #c6b58e;
      }

      .retry {
        background: #1e1e1e;
        border-color: #444;
      }

      .hint {
        color: #aaa;
      }

      .secondary {
        background: #1e1e1e;
        color: #fff8e1;
        border-color: #444;
      }
    }
  </style>
</head>

<body>
  <main class="error-page">

    <div class="error-code">429</div>

    <h1>Too many requests</h1>

    <p class="message">
      You've made too many requests in a short period.
      Please wait before trying again.
    </p>

    <section class="retry">
      <p class="retry-label">You can try again in:</p>

      <div class="timer" id="timer"
        data-seconds="<%= typeof retryAfterSeconds !== 'undefined' && Number.isFinite(Number(retryAfterSeconds)) && Number(retryAfterSeconds) > 0 ? Math.ceil(Number(retryAfterSeconds)) : 300 %>">
        05:00
      </div>

      <p class="hint" id="hint">
        Please wait while the rate limit resets.
      </p>

      <button class="btn primary" id="retryButton" disabled>
        Try Again
      </button>
    </section>
  </main>
  <script src="/script/theme-toggle.js"></script>
  <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
    (() => {
      const timer = document.getElementById("timer");
      const button = document.getElementById("retryButton");
      const hint = document.getElementById("hint");

      let seconds = Number(timer.dataset.seconds);

      if (!Number.isFinite(seconds) || seconds <= 0) {
        seconds = 300;
      }

      const deadline = Date.now() + seconds * 1000;

      function updateCountdown() {
        const remaining = Math.max(
          0,
          Math.ceil((deadline - Date.now()) / 1000)
        );

        const minutes = Math.floor(remaining / 60);
        const secs = remaining % 60;

        timer.textContent =
          String(minutes).padStart(2, "0") + ":" +
          String(secs).padStart(2, "0");

        if (remaining === 0) {
          clearInterval(interval);

          hint.textContent = "You can try again now.";
          button.disabled = false;
        }
      }

      updateCountdown();

      const interval = setInterval(updateCountdown, 250);

      button.addEventListener("click", () => {
        if (button.disabled) return;

        button.disabled = true;
        button.textContent = "Retrying...";

        window.location.reload();
      });
    })();
  </script>

</body>
</html>
