<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#FFB300" />
  <title>429 · Too Many Requests · LinkVault</title>
  <link href="style/font.css" rel="stylesheet" />
  <link rel="stylesheet" href="style/properties.css" />
  <style>
  
:root {
  /* ========================================
     COLORS - Base Palette
  ======================================== */
  --gold-50:  #FFF8E1;
  --gold-100: #FFECB3;
  --gold-200: #FFE082;
  --gold-300: #FFD54F;
  --gold-400: #FFCA28;
  --gold-500: #FFB300;
  --gold-600: #FFA000;
  --gold-700: #FF8F00;
  --gold-800: #FF6F00;
  --gold-900: #E65100;

  --orange-400: #FFB74D;
  --orange-500: #FFA726;
  --orange-600: #FB8C00;
  --orange-700: #F57C00;

  /* ========================================
     SEMANTIC COLORS
  ======================================== */
  --color-primary:        var(--gold-500);
  --color-primary-hover:  var(--gold-600);
  --color-primary-active: var(--gold-700);
  --color-accent:         var(--orange-600);
  --color-success:        #43A047;
  --color-warning:        #FB8C00;
  --color-danger:         #E53935;
  --color-info:           #1E88E5;

  /* ========================================
     BACKGROUNDS & SURFACES
  ======================================== */
  --bg:                   #FFFFFF;
  --bg-app:               #FFFFFF;
  --bg-primary:           #FFFFFF;
  --bg-secondary:         #FFF8E1;
  --bg-tertiary:          #FFECB3;
  --bg-elevated:          #FFFFFF;
  --bg-header:            #FFFFFF;
  --bg-hero:              linear-gradient(135deg, #FFCA28 0%, #FFB300 35%, #FF8F00 70%, #EF6C00 100%);
  --bg-card:              #FFFFFF;
  --bg-sidebar:           #FFF8E1;
  --bg-footer:            #FFF8E1;
  --bg-overlay:           rgba(26, 18, 7, 0.55);
  --bg-input:             #FFFFFF;
  --bg-disabled:          #F5F5F5;

  /* ========================================
     TEXT
  ======================================== */
  --text-primary:         #1A1207;
  --text-secondary:       #5C4A2A;
  --text-tertiary:        #8B7355;
  --text-inverse:         #FFFFFF;
  --text-muted:           #A1887F;
  --text-link:            var(--gold-700);
  --text-link-hover:      var(--gold-800);

  /* ========================================
     BORDERS
  ======================================== */
  --border-color:         #FFE082;
  --border-strong:        #FFD54F;
  --border-subtle:        #FFF3E0;
  --border-focus:         var(--gold-500);
  --border-width:         1px;
  --border-width-thick:   2px;

  /* ========================================
     SHADOWS
  ======================================== */
  --shadow-xs:            0 1px 2px rgba(230, 81, 0, 0.06);
  --shadow-sm:            0 1px 3px rgba(230, 81, 0, 0.08);
  --shadow-md:            0 4px 12px rgba(230, 81, 0, 0.12);
  --shadow-lg:            0 10px 28px rgba(230, 81, 0, 0.16);
  --shadow-xl:            0 20px 40px rgba(230, 81, 0, 0.20);
  --shadow-card:          var(--shadow-sm);
  --shadow-header:        0 1px 0 rgba(0, 0, 0, 0.05);
  --shadow-dropdown:      var(--shadow-lg);

  /* ========================================
     TYPOGRAPHY
  ======================================== */
  --font-sans:            'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-mono:            'JetBrains Mono', 'Fira Code', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  --font-display:         'Inter', system-ui, sans-serif;

  --font-size-xs:         0.75rem;    /* 12px */
  --font-size-sm:         0.875rem;   /* 14px */
  --font-size-base:       1rem;       /* 16px */
  --font-size-lg:         1.125rem;   /* 18px */
  --font-size-xl:         1.25rem;    /* 20px */
  --font-size-2xl:        1.5rem;     /* 24px */
  --font-size-3xl:        1.875rem;   /* 30px */
  --font-size-4xl:        2.25rem;    /* 36px */
  --font-size-5xl:        3rem;       /* 48px */
  --font-size-6xl:        3.75rem;    /* 60px */

  --font-weight-normal:   400;
  --font-weight-medium:   500;
  --font-weight-semibold: 600;
  --font-weight-bold:     700;

  --line-height-tight:    1.25;
  --line-height-snug:     1.375;
  --line-height-normal:   1.5;
  --line-height-relaxed:  1.625;

  --letter-spacing-tight: -0.025em;
  --letter-spacing-normal: 0;
  --letter-spacing-wide:  0.025em;

  /* ========================================
     SPACING
  ======================================== */
  --space-0:              0;
  --space-1:              0.25rem;    /* 4px */
  --space-2:              0.5rem;     /* 8px */
  --space-3:              0.75rem;    /* 12px */
  --space-4:              1rem;       /* 16px */
  --space-5:              1.25rem;    /* 20px */
  --space-6:              1.5rem;     /* 24px */
  --space-8:              2rem;       /* 32px */
  --space-10:             2.5rem;     /* 40px */
  --space-12:             3rem;       /* 48px */
  --space-16:             4rem;       /* 64px */
  --space-20:             5rem;       /* 80px */
  --space-24:             6rem;       /* 96px */

  /* ========================================
     RADIUS
  ======================================== */
  --radius-sm:            0.375rem;   /* 6px */
  --radius-md:            0.5rem;     /* 8px */
  --radius-lg:            0.75rem;    /* 12px */
  --radius-xl:            1rem;       /* 16px */
  --radius-2xl:           1.25rem;    /* 20px */
  --radius-3xl:           1.5rem;     /* 24px */
  --radius-full:          9999px;
  --radius-card:          var(--radius-xl);
  --radius-button:        var(--radius-lg);
  --radius-input:         var(--radius-md);

  /* ========================================
     TRANSITIONS
  ======================================== */
  --transition-fast:      150ms ease;
  --transition-base:      200ms ease;
  --transition-slow:      300ms ease;
  --transition-theme:     250ms ease;

  /* ========================================
     LAYOUT / COMPONENTS
  ======================================== */
  --header-height:        64px;
  --sidebar-width:        260px;
  --sidebar-collapsed:    72px;
  --container-max:        1200px;
  --container-padding:    var(--space-6);

  --card-padding:         var(--space-6);
  --card-gap:             var(--space-4);

  --button-height-sm:     32px;
  --button-height-md:     40px;
  --button-height-lg:     48px;

  --input-height:         42px;
  --input-padding-x:      var(--space-4);

  --hero-padding-y:       var(--space-20);
  --section-padding-y:    var(--space-16);

  /* ========================================
     Z-INDEX
  ======================================== */
  --z-dropdown:           1000;
  --z-sticky:             1100;
  --z-header:             1200;
  --z-modal:              1300;
  --z-toast:              1400;
  --z-tooltip:            1500;
}


/* ========================================
   DARK THEME
======================================== */
[data-theme="dark"], .dark {
  --bg:                 #121212;
  --bg-app:               #121212;
  --bg-primary:           #121212;
  --bg-secondary:         #1E1E1E;
  --bg-tertiary:          #2A2A2A;
  --bg-elevated:          #1E1E1E;
  --bg-header:            #1A1A1A;
  --bg-hero:              linear-gradient(135deg, #FFCA28 0%, #FFB300 35%, #FF8F00 70%, #EF6C00 100%);
  --bg-card:              #1E1E1E;
  --bg-sidebar:           #1A1A1A;
  --bg-footer:            #1A1A1A;
  --bg-overlay:           rgba(0, 0, 0, 0.65);
  --bg-input:             #2A2A2A;
  --bg-disabled:          #2A2A2A;

  --text-primary:         #FFF8E1;
  --text-secondary:       #FFE082;
  --text-tertiary:        #FFD54F;
  --text-inverse:         #121212;
  --text-muted:           #A1887F;
  --text-link:            var(--gold-400);
  --text-link-hover:      var(--gold-300);

  --border-color:         #3A3A3A;
  --border-strong:        #FF8F00;
  --border-subtle:        #2A2A2A;
  --border-focus:         var(--gold-400);

  --shadow-xs:            0 1px 2px rgba(0, 0, 0, 0.4);
  --shadow-sm:            0 1px 3px rgba(0, 0, 0, 0.5);
  --shadow-md:            0 4px 12px rgba(0, 0, 0, 0.55);
  --shadow-lg:            0 10px 28px rgba(0, 0, 0, 0.6);
  --shadow-xl:            0 20px 40px rgba(0, 0, 0, 0.7);
  --shadow-card:          var(--shadow-sm);
  --shadow-header:        0 1px 0 rgba(255, 255, 255, 0.05);
  --shadow-dropdown:      var(--shadow-lg);

  --color-primary:        #FFCA28;
  --color-primary-hover:  #FFD54F;
  --color-primary-active: #FFE082;
  --color-accent:         #FFB74D;
}
  </style>
  <style>
    /* ========================================
      LinkVault - Base Styles
      Built on top of properties.css
    ======================================== */

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      scrollbar-width: thin;
      scrollbar-color: var(--gold-400) transparent;
    }

    html {
      font-size: 16px;
      -webkit-text-size-adjust: 100%;
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font-sans);
      font-size: var(--font-size-base);
      line-height: var(--line-height-normal);
      color: var(--text-primary);
      background-color: var(--bg-app);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    a {
      color: var(--text-link);
      text-decoration: none;
      transition: color var(--transition-fast);
    }

    a:hover {
      color: var(--text-link-hover);
    }

    .page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .page-center {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-6);
    }
    /* ========== Buttons ========== */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      height: var(--button-height-md);
      padding: 0 var(--space-5);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);
      border-radius: var(--radius-button);
      border: none;
      cursor: pointer;
      transition: background var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
      text-decoration: none;
      white-space: nowrap;
    }

    .btn:active {
      transform: translateY(1px);
    }

    .btn-primary {
      background: var(--color-primary);
      color: var(--text-inverse);
    }

    .btn-primary:hover {
      background: var(--color-primary-hover);
      color: var(--text-inverse);
    }

    .btn-primary:active {
      background: var(--color-primary-active);
    }

    .btn-secondary {
      background: var(--bg-secondary);
      color: var(--text-primary);
      border: var(--border-width) solid var(--border-color);
    }

    .btn-secondary:hover {
      background: var(--bg-tertiary);
    }
 
    /* ========== Error Pages ========== */
    .error-page {
      text-align: center;
      max-width: 480px;
    }

    .error-code {
      font-size: var(--font-size-6xl);
      font-weight: var(--font-weight-bold);
      color: var(--color-primary);
      line-height: 1;
      margin-bottom: var(--space-4);
    }

    .error-title {
      font-size: var(--font-size-2xl);
      font-weight: var(--font-weight-bold);
      margin-bottom: var(--space-3);
    }

    .error-message {
      color: var(--text-secondary);
      margin-bottom: var(--space-8);
      line-height: var(--line-height-relaxed);
    }

 
    .flex { display: flex; }
    .gap-3 { gap: var(--space-3); }

  </style>
</head>
<body>
  <div class="page-center">
    <div class="error-page">
      <div class="error-code">429</div>
      <h1 class="error-title">Too many requests</h1>
      <p class="error-message">
        You don't have permission to view this page.
        Please sign in with an account that has the required access.
      </p>
      <div class="flex gap-3" style="justify-content: center;">
        <a href="/auth/signin" class="btn btn-primary">Sign In</a>
        <a href="/" class="btn btn-secondary">Go Home</a>
      </div>
    </div>
  </div>
</body>
</html>
