<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#FFB300" />
  <title>404 · Page Not Found · LinkVault</title>
  <link rel="icon" href="icons/ico/logo.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="icons/png/logo-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="icons/png/logo-16x16.png">
  <!-- Apple Touch Icon -->
  <link rel="apple-touch-icon" href="icons/png/apple-tourch.png">
  <link rel="preconnect" href="style/font-icon/css/all.min.css" />
  <link rel="preconnect" href="style/font/inter-family.woff2" />
  <link href="style/font.css" rel="stylesheet" />
  <link rel="stylesheet" href="style/properties.css" />
  <link rel="stylesheet" href="style/base.css" />
</head>
<body>
  <div class="page-center">
    <div class="error-page">
      <div class="error-code">404</div>
      <h1 class="error-title">Page not found</h1>
      <p class="error-message">
        The page you're looking for doesn't exist or has been moved.
        Double-check the URL or head back home.
      </p>
      <div class="flex gap-3" style="justify-content: center;">
        <a href="/" class="btn btn-primary">Go Home</a>
        <% try { %>
          <% if (valid) { %>
            <a href="/dashboard" class="btn btn-secondary">Dashboard</a>
          <% } else{ %>
            <a href="/auth/signin" class="btn btn-secondary">Sign In</a>  
          <% } %>
        <% } catch (error) { %>
          <a href="/auth/signin" class="btn btn-secondary">Sign In</a>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
