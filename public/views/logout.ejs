<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#FFB300" />
  <title>Logged Out · LinkVault</title>
  <!-- Favicon -->
  <link rel="icon" href="icons/ico/logo.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="icons/png/logo-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="icons/png/logo-16x16.png">
  <!-- Apple Touch Icon -->
  <link rel="apple-touch-icon" href="icons/png/apple-tourch.png">
  <!-- PWA / App Icons -->
  <link rel="icon" type="image/png" sizes="180x150" href="icons/png/logo-180x180.png">
  <link rel="icon" type="image/png" sizes="512x512" href="icons/png/logo-512x512.png">

  <link rel="preconnect" href="style/font-icon/css/all.min.css" />
  <link rel="preconnect" href="style/font/inter-family.woff2" />
  <link rel="stylesheet" href="style/properties.css" />
  <link rel="stylesheet" href="style/font.css" />
  <link rel="stylesheet" href="style/base.css" />
  <style>
    body {
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }
    .card {
      width: 100%;
      max-width: 400px;
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 40px 32px;
      text-align: center;
      box-shadow: var(--shadow-md);
    }
    .logo {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-weight: var(--font-weight-semibold);
      font-size: var(--font-size-ms);
    }
    .icon {
      width: 64px;
      height: 64px;
      background: var(--gold-400);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      text-aligin: center;
      margin: 0 auto 24px;
      color: var(--primary-hover);
    }
    .icon svg {
      width: 30px;
      height: 30px;
      position: relative;
      left: 4px;
    }
    h1 {
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.03em;
      margin-bottom: 10px;
    }
    p {
      color: var(--text-muted);
      font-size: 14.5px;
      margin-bottom: 28px;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding: 12px;
      border-radius: 10px;
      font-size: 14.5px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      border: none;
      transition: background 0.2s;
      text-decoration: none;
      color: white;
      background: var(--gold-300);
      margin-bottom: 10px;
    }
    .btn:hover { background: var(--gold-400); color: var(--text); }
    .btn-ghost {
      background: transparent;
      color: var(--text-muted);
      border: 1px solid var(--border-color);
    }
    .btn-ghost:hover {
      background: var(--border-strong);
      color: var(--text);
    }
    .brand {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 28px;
      font-size: 13px;
      color: var(--text-muted);
    }

  </style>
</head>
<body>
  <div class="card">
    <div class="icon">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
    </div>

    <h1>You've been logged out</h1>
    <p>Your session has ended. Come back anytime to manage your short links.</p>
    <a href="signin.html" class="btn">Sign in again</a>
    <a href="index.html" class="btn btn-ghost">Back to home</a>
    <div class="brand">
      <div class="logo">
        <span>Link</span>Vault
      </div>
    </div>
  </div>
</body>
</html>
