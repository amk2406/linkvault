<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#FFB300" />
  <title>Logged Out · LinkVault</title>
  <link rel="stylesheet" href="/static/style/properties.css" />
  <link rel="stylesheet" href="/static/style/base.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="page-center">
    <div class="card card-elevated logout-card">
      <div class="logout-icon">👋</div>
      <h1 style="font-size: var(--font-size-xl); margin-bottom: var(--space-2);">You've been logged out</h1>
      <p class="text-muted" style="margin-bottom: var(--space-8);">
        Your session has ended safely. Come back anytime.
      </p>

      <div class="flex gap-3" style="justify-content: center;">
        <a href="/auth/signin" class="btn btn-primary">Sign In again</a>
        <a href="/" class="btn btn-secondary">Go Home</a>
      </div>
    </div>
  </div>
</body>
</html>
