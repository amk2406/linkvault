<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#FFB300" />
  <title><%= typeof title !== 'undefined' ? title + ' · LinkVault' : 'LinkVault' %></title>

  <!-- Design system -->
  <link rel="stylesheet" href="/static/style/properties.css" />
  <link rel="stylesheet" href="/static/style/base.css" />

  <!-- Inter font (local or CDN fallback) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <% if (typeof extraHead !== 'undefined') { %><%- extraHead %><% } %>
</head>
<body>
  <%- body %>

  <% if (typeof extraScripts !== 'undefined') { %><%- extraScripts %><% } %>
</body>
</html>
